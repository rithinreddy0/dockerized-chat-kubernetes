{
  "name": "course-chat",
  "version": "1.0.0",
  "private": true,
  "description": "6.0 Dockerized Chat Application with Kubernetes",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test test/unit.test.js",
    "test:integration": "node --test test/integration.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check client/src/useChat.js && node --check vite.config.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^5.1.0",
    "redis": "^5.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": { "vite": "^8.0.0", "@vitejs/plugin-react": "^6.0.0", "yaml": "^2.8.1" }
}
